# Dependencies
node_modules/

# Rust / Tauri build output (5.7 GB — never commit)
src-tauri/target/

# Generated mobile projects (regenerated by `tauri android/ios init`)
# Keep them out of git; CI/devs re-init. If you later customize native code,
# selectively force-add only the files you changed.
src-tauri/gen/

# Tauri signing keys — NEVER commit
*.keystore
*.jks
*.p12
*.p8
src-tauri/*.key

# Build artifacts
*.apk
*.aab
*.app
*.dmg
*.ipa

# OS / editor cruft
.DS_Store
*.log
Thumbs.db
.idea/
.vscode/
Sutra-debug-latest.apk
